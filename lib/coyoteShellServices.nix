# Coyote's dynamic shell services as a Nix attribute set, and their
# translation to Coyote's CMake settings.
{ lib }:
let
  fail = message: throw "coyote-nix: shell services: ${message}";

  defaults = {
    # Host streams per vFPGA (EN_STRM, N_STRM_AXI); 0 disables them.
    hostStreams = 1;
    # Card memory (HBM) streams per vFPGA (EN_MEM, N_CARD_AXI); 0 disables.
    cardMemory = 0;
    rdma = false;
    tcp = false;
    # Packet sniffer, delivering to vFPGA 0.
    sniffer = false;
    # vFPGA regions (N_REGIONS).
    vfpgas = 1;
    # Reconfiguration configurations per region (N_CONFIG).
    configurations = 1;
  };

  isCount = min: value: builtins.isInt value && value >= min;
in
rec {
  inherit defaults;

  # Fill defaults and reject unknown or invalid services.
  normalize =
    board: services:
    let
      unknown = lib.subtractLists (lib.attrNames defaults) (lib.attrNames services);
      s = defaults // services;
      networking = s.rdma || s.tcp || s.sniffer;
      known = lib.concatStringsSep ", " (lib.attrNames defaults);
    in
    if !builtins.isAttrs services then
      fail "services must be an attribute set"
    else if unknown != [ ] then
      fail "unknown ${lib.concatStringsSep ", " unknown}; known: ${known}"
    else if !isCount 0 s.hostStreams then
      fail "hostStreams must be a non-negative integer"
    else if !isCount 0 s.cardMemory then
      fail "cardMemory must be a non-negative integer"
    else if
      !builtins.all builtins.isBool [
        s.rdma
        s.tcp
        s.sniffer
      ]
    then
      fail "rdma, tcp and sniffer must be Booleans"
    # 32 is Coyote's largest shell (V80 without application reconfiguration);
    # Coyote's CMake enforces the lower limits of other boards and of PR.
    else if !isCount 1 s.vfpgas || s.vfpgas > 32 then
      fail "vfpgas must be an integer from 1 to 32"
    else if !isCount 1 s.configurations then
      fail "configurations must be a positive integer"
    else if board == "v80" && networking then
      fail "Coyote has no networking (rdma, tcp, sniffer) on the V80"
    else
      s;

  # CMake settings, in Coyote's names.
  settings = s: {
    EN_STRM = if s.hostStreams > 0 then 1 else 0;
    N_STRM_AXI = lib.max 1 s.hostStreams;
    EN_MEM = if s.cardMemory > 0 then 1 else 0;
    N_CARD_AXI = lib.max 1 s.cardMemory;
    EN_RDMA = if s.rdma then 1 else 0;
    EN_TCP = if s.tcp then 1 else 0;
    EN_SNIFFER = if s.sniffer then 1 else 0;
    N_REGIONS = s.vfpgas;
    N_CONFIG = s.configurations;
  };

  toFlag = name: value: "-D${name}:STRING=${toString value}";
  cmakeFlags = s: lib.mapAttrsToList toFlag (settings s);

  # A readable name, such as strm2-mem1-rdma.
  name =
    s:
    let
      parts =
        lib.optional (s.hostStreams > 0) "strm${toString s.hostStreams}"
        ++ lib.optional (s.cardMemory > 0) "mem${toString s.cardMemory}"
        ++ lib.optional s.rdma "rdma"
        ++ lib.optional s.tcp "tcp"
        ++ lib.optional s.sniffer "sniffer"
        ++ lib.optional (s.vfpgas > 1) "vfpga${toString s.vfpgas}"
        ++ lib.optional (s.configurations > 1) "cfg${toString s.configurations}";
    in
    if parts == [ ] then "bare" else lib.concatStringsSep "-" parts;

  # The vfpga_top.svh of the placeholder app for one region. It loops host
  # and card streams back and ties off every other interface, mirroring the
  # ports Coyote's user_logic template generates for these services.
  placeholderApp =
    s: region:
    let
      net = s.rdma || s.tcp || s.sniffer;
    in
    ''
      // Placeholder vFPGA generated by coyote-nix for a shell build.
      import lynxTypes::*;

      always_comb axi_ctrl.tie_off_s();
      always_comb notify.tie_off_m();
      always_comb sq_rd.tie_off_m();
      always_comb sq_wr.tie_off_m();
      always_comb cq_rd.tie_off_s();
      always_comb cq_wr.tie_off_s();
    ''
    + lib.optionalString s.rdma ''
      always_comb rq_rd.tie_off_s();
    ''
    + lib.optionalString net ''
      always_comb rq_wr.tie_off_s();
    ''
    + lib.optionalString (s.hostStreams > 0) ''

      for (genvar i = 0; i < N_STRM_AXI; i++) begin : gen_host_loopback
          assign axis_host_send[i].tdata  = axis_host_recv[i].tdata;
          assign axis_host_send[i].tkeep  = axis_host_recv[i].tkeep;
          assign axis_host_send[i].tlast  = axis_host_recv[i].tlast;
          assign axis_host_send[i].tid    = axis_host_recv[i].tid;
          assign axis_host_send[i].tvalid = axis_host_recv[i].tvalid;
          assign axis_host_recv[i].tready = axis_host_send[i].tready;
      end
    ''
    + lib.optionalString (s.cardMemory > 0) ''

      for (genvar i = 0; i < N_CARD_AXI; i++) begin : gen_card_loopback
          assign axis_card_send[i].tdata  = axis_card_recv[i].tdata;
          assign axis_card_send[i].tkeep  = axis_card_recv[i].tkeep;
          assign axis_card_send[i].tlast  = axis_card_recv[i].tlast;
          assign axis_card_send[i].tid    = axis_card_recv[i].tid;
          assign axis_card_send[i].tvalid = axis_card_recv[i].tvalid;
          assign axis_card_recv[i].tready = axis_card_send[i].tready;
      end
    ''
    + lib.optionalString s.rdma ''

      for (genvar i = 0; i < N_RDMA_AXI; i++) begin : gen_rdma_tie_off
          always_comb begin
              axis_rreq_send[i].tie_off_m();
              axis_rreq_recv[i].tready = 1'b1;
              axis_rrsp_send[i].tie_off_m();
              axis_rrsp_recv[i].tready = 1'b1;
          end
      end
    ''
    + lib.optionalString s.tcp ''

      for (genvar i = 0; i < N_TCP_AXI; i++) begin : gen_tcp_tie_off
          always_comb begin
              axis_tcp_send[i].tie_off_m();
              axis_tcp_recv[i].tready = 1'b1;
          end
      end
    ''
    + lib.optionalString (s.sniffer && region == 0) ''

      always_comb begin
          axis_rx_sniffer.tready = 1'b1;
          axis_tx_sniffer.tready = 1'b1;
          filter_config.tie_off_m();
      end
    '';
}
