# Applies only canonical declarative placement groups generated by coyote-placement-hints.py.
# No user Tcl, timing constraints, or arbitrary Vivado commands are accepted here.

proc coyote_hint_is_true {value} {
    return [expr {[string tolower $value] in {1 true yes on}}]
}

proc coyote_hint_is_below {name root} {
    return [expr {$name eq $root || [string first "${root}/" $name] == 0}]
}

proc coyote_hint_property_true {cell property} {
    if {[catch {set value [get_property -quiet $property $cell]}]} {
        return 0
    }
    return [coyote_hint_is_true $value]
}

proc coyote_apply_placement_hints {} {
    if {![info exists ::coyote_placement_hint_groups]} {
        error "placement hint inputs were not initialized"
    }

    # Capabilities belong to one input application, not the Vivado session.
    set require_placement [expr {[info exists ::coyote_placement_hint_required] && $::coyote_placement_hint_required}]
    set allow_unplaced_static [expr {[info exists ::coyote_placement_hint_unplaced_static] && $::coyote_placement_hint_unplaced_static}]
    set ::coyote_placement_hint_required 0
    set ::coyote_placement_hint_unplaced_static 0

    set all_cells [get_cells -hier]
    set names {}
    set primitive_names {}
    set cell_by_name [dict create]
    set rp_roots {}
    foreach cell $all_cells {
        set name [get_property NAME $cell]
        lappend names $name
        dict set cell_by_name $name $cell
        if {[coyote_hint_property_true $cell IS_PRIMITIVE]} {
            lappend primitive_names $name
        }
        if {[coyote_hint_property_true $cell HD.RECONFIGURABLE]} {
            lappend rp_roots $name
        }
    }

    set static_root inst_static
    if {[lsearch -exact $names $static_root] < 0} {
        error "linked design lacks the frozen static insertion root inst_static"
    }
    set expected_rp_root inst_shell/inst_dynamic/inst_user_wrapper_0
    if {[lsearch -exact $rp_roots $expected_rp_root] < 0} {
        error "linked design lacks the expected Coyote RP root or its reconfigurable marker"
    }
    set all_pblocks [get_pblocks -quiet *]
    set pblock_names {}
    set occupied_sites [dict create]
    set occupied_cells {}
    foreach pblock $all_pblocks {
        set name [get_property NAME $pblock]
        lappend pblock_names $name
        foreach site [get_sites -quiet -of_objects $pblock] {
            dict set occupied_sites [get_property NAME $site] 1
        }
        foreach cell [get_cells -quiet -of_objects $pblock] {
            lappend occupied_cells [get_property NAME $cell]
        }
    }

    set prepared {}
    set all_selected_names [dict create]
    set all_selector_names {}
    set all_hint_sites [dict create]
    foreach group $::coyote_placement_hint_groups {
        lassign $group group_name selectors site_names
        set pblock_name "coyote_hint_${group_name}"
        if {[lsearch -exact $pblock_names $pblock_name] >= 0} {
            error "placement hint pblock already exists: $pblock_name"
        }

        set cells {}
        set resolved_names {}
        foreach selector $selectors {
            if {![dict exists $cell_by_name $selector]} {
                error "placement selector must resolve to exactly one cell: $selector"
            }
            set name $selector
            set expanded_names {}
            foreach primitive_name $primitive_names {
                if {[coyote_hint_is_below $primitive_name $name]} {
                    lappend expanded_names $primitive_name
                }
            }
            if {[llength $expanded_names] == 0} {
                error "placement selector has no primitive descendants: $name"
            }
            foreach expanded_name $expanded_names {
                # Primitive leaves cannot contain one another; exact membership
                # avoids quadratic comparisons for wide register banks.
                if {[dict exists $all_selected_names $expanded_name]} {
                    error "expanded placement membership overlaps: $expanded_name"
                }
                dict set all_selected_names $expanded_name 1
                lappend cells [dict get $cell_by_name $expanded_name]
            }
            foreach selected $all_selector_names {
                if {[coyote_hint_is_below $name $selected] || [coyote_hint_is_below $selected $name]} {
                    error "placement selectors overlap hierarchically: $name and $selected"
                }
            }
            lappend all_selector_names $name
            lappend resolved_names $name
        }

        set sites {}
        set resolved_site_names {}
        foreach selector $site_names {
            set matches [get_sites -quiet $selector]
            if {[llength $matches] != 1 || [get_property NAME [lindex $matches 0]] ne $selector} {
                error "placement site must resolve to exactly one site: $selector"
            }
            if {[dict exists $all_hint_sites $selector]} {
                error "placement site is selected more than once: $selector"
            }
            dict set all_hint_sites $selector 1
            lappend resolved_site_names $selector
            lappend sites [lindex $matches 0]
        }

        foreach name $resolved_names {
            set unplaced_static 0
            if {[coyote_hint_is_below $name $static_root] ||
                [coyote_hint_is_below $static_root $name]} {
                if {!$allow_unplaced_static ||
                    $name eq $static_root ||
                    ![coyote_hint_is_below $name $static_root]} {
                    error "placement selector intersects frozen static hierarchy: $name"
                }
                set unplaced_static 1
            }
            foreach rp_root $rp_roots {
                if {[coyote_hint_is_below $name $rp_root] ||
                    [coyote_hint_is_below $rp_root $name]} {
                    error "placement selector intersects reconfigurable partition: $name"
                }
            }
            if {[coyote_hint_property_true [dict get $cell_by_name $name] IS_LOC_FIXED] ||
                [coyote_hint_property_true [dict get $cell_by_name $name] IS_BEL_FIXED]} {
                error "placement selector is fixed: $name"
            }
            foreach protected_cell_name $names {
                if {[coyote_hint_is_below $protected_cell_name $name] ||
                    [coyote_hint_is_below $name $protected_cell_name]} {
                    set protected_cell [dict get $cell_by_name $protected_cell_name]
                    if {$unplaced_static &&
                        [coyote_hint_is_below $protected_cell_name $name] &&
                        [coyote_hint_property_true $protected_cell IS_PRIMITIVE]} {
                        if {[catch {set location [get_property -quiet LOC $protected_cell]}]} {
                            error "cannot establish unplaced static cell: $protected_cell_name"
                        }
                        if {$location ne ""} {
                            error "static placement requires unplaced cells: $protected_cell_name"
                        }
                        if {[get_property -quiet PRIMITIVE_GROUP $protected_cell] eq "CLOCK"} {
                            error "static placement cannot select clock resources: $protected_cell_name"
                        }
                    }
                    if {[coyote_hint_property_true $protected_cell IS_LOC_FIXED] ||
                        [coyote_hint_property_true $protected_cell IS_BEL_FIXED]} {
                        error "placement selector intersects a fixed cell: $protected_cell_name"
                    }
                }
            }
            foreach occupied_cell $occupied_cells {
                if {[coyote_hint_is_below $occupied_cell $name] ||
                    [coyote_hint_is_below $name $occupied_cell]} {
                    error "placement selector intersects existing pblock membership: $occupied_cell"
                }
            }
        }
        foreach site $resolved_site_names {
            if {[dict exists $occupied_sites $site]} {
                error "placement site collides with an existing pblock: $site"
            }
        }
        lappend prepared [list $pblock_name $cells $sites]
    }

    # Mutate only after all selectors, protected regions, and collisions pass.
    foreach item $prepared {
        lassign $item pblock_name cells sites
        set pblock [create_pblock $pblock_name]
        set soft true
        if {$require_placement} {
            set soft false
        }
        set_property IS_SOFT $soft $pblock
        resize_pblock $pblock -add $sites
        add_cells_to_pblock $pblock $cells
    }
}
